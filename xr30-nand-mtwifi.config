# XR30 NAND 编译配置 — padavanonly/immortalwrt-mt798x-6.6 (ImmortalWrt 24.10, 内核 6.6)
# 布局: ubootmod / H 大 fixed-parts (bl-mt798x-xr30 恢复台)
# 驱动: MTK mtwifi 闭源 (mt7915_mtwifi)，关 mt76
# 预置: iStore + 无线中继面板 + USB RNDIS/NCM/QMI 4G + QModem + OpenClash + apcli PMF 补丁
# 用法: cp 本文件为 openwrt/.config 后 `make defconfig` 展开默认项

# === 目标设备: CMCC XR30 NAND (mediatek/mt7981) ===
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7981=y
CONFIG_TARGET_mediatek_mt7981_DEVICE_cmcc_xr30_nand=y

# === 无线: MTK mtwifi 闭源驱动 (非 mt76 开源) ===
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-mtwifi=y
CONFIG_PACKAGE_luci-app-mtk=y          # MTK 原厂无线/中继(WISP)配置面板
# CONFIG_PACKAGE_kmod-mt76 is not set

# === iStore 应用商店 ===
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-compat=y          # 兼容 lua 版 Luci 应用(QModem/luci-app-mtk 需要)

# === USB 4G: RNDIS / NCM / QMI ===
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-ncm=y

# === QModem (FUjr/modem_feeds) — 5G/4G 模组管理面板 ===
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-mwan=y
CONFIG_PACKAGE_kmod-mhi=y              # PCIe 5G 模组(如 RM5xxQ)支持

# === OpenClash (vernesong) — fw4 / nftables 模式 ===
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y

# === Web 终端 + 常用工具 ===
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_luci-theme-argon=y

# === 基础 Luci ===
CONFIG_PACKAGE_luci=y
